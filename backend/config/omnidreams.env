# TrafficWM OmniDreams backend configuration.
#
# This file is loaded by scripts/run_manager.sh after the normal .env files.
# An already exported variable takes precedence, so temporary command-line
# overrides remain possible without editing this file.

# quality: full Wan VAE offline comparison path; it is not the Wenying default.
# realtime: LightVAE + LightTAE with compile disabled for conservative long runs.
# realtime_fast: compiled LightVAE + LightTAE, validated near 30 fps on four GPUs.
# Set OMNIDREAMS_PROFILE=realtime to restore the previous stable runtime.
export OMNIDREAMS_PROFILE="${OMNIDREAMS_PROFILE:-realtime_fast}"

# Keep the world-model rollout deterministic and separate from the traffic
# simulator seed. Seed 1 matches the official sample recipe and was the most
# stable validated choice on the Xi'an Wenying 20-40 s comparisons. Override
# per workflow with world_omnidreams_seed when an explicit A/B run is needed.
export OMNIDREAMS_SEED="${OMNIDREAMS_SEED:-1}"

# The current demo does not use Transfer2.5 during live generation. Keeping it
# disabled releases GPUs 0-3 to the lowest-latency OmniDreams partition. Set
# COSMOS_TRANSFER_ENABLED=1 to restore Transfer; run_manager.sh then moves the
# realtime_fast OmniDreams service to GPUs 4-7 unless explicitly overridden.
export COSMOS_TRANSFER_ENABLED="${COSMOS_TRANSFER_ENABLED:-0}"

# Startup world-seed generator. Transfer1 uses the official traditional HDMap
# renderer and its complete 121-frame, 24 fps front-view sample. Operational
# traffic starts from generated frame 120, aligned with warmup t=5.0 s. Set this
# to transfer2.5 and enable COSMOS_TRANSFER_ENABLED to restore the previous
# seven-view warmup path.
export COSMOS_SEED_BACKEND="${COSMOS_SEED_BACKEND:-transfer1}"
export COSMOS_TRANSFER1_ROOT="${COSMOS_TRANSFER1_ROOT:-/mnt/rk/cosmos/Cosmos-Drive-Dreams}"
export COSMOS_TRANSFER1_GPUS="${COSMOS_TRANSFER1_GPUS:-4,5,6,7}"
export COSMOS_TRANSFER1_GUIDANCE="${COSMOS_TRANSFER1_GUIDANCE:-5}"
export COSMOS_TRANSFER1_MAX_ATTEMPTS="${COSMOS_TRANSFER1_MAX_ATTEMPTS:-1}"
export COSMOS_TRANSFER1_TIMEOUT_SECONDS="${COSMOS_TRANSFER1_TIMEOUT_SECONDS:-7200}"
export COSMOS_TRANSFER1_RENDER_TIMEOUT_SECONDS="${COSMOS_TRANSFER1_RENDER_TIMEOUT_SECONDS:-1800}"

# terminal_continue uses generated frame 120 and continues from traffic t=5 s.
# opening_restart uses generated frame 0 and restores the exact pre-warmup
# simulator/RNG state before operational traffic starts.
export COSMOS_SEED_ALIGNMENT_MODE="${COSMOS_SEED_ALIGNMENT_MODE:-terminal_continue}"

# Request the exact HDMap and dynamic-actor condition frames rendered inside
# the OmniDreams service. They are stored beside the RGB video for inspection.
export OMNIDREAMS_SAVE_CONTROL_VIDEO="${OMNIDREAMS_SAVE_CONTROL_VIDEO:-1}"

# Moving streams can be restarted at the nearest native 5+8n frame boundary.
# 0 keeps one unbounded autoregressive session. The validated Wenying result
# uses 0 because generated-frame rollover amplified appearance artifacts.
export OMNIDREAMS_SEGMENT_SECONDS="${OMNIDREAMS_SEGMENT_SECONDS:-0}"

# Number of generated frames dissolved across a session boundary. 0 preserves
# the raw boundary; 8 is about 0.267 s at the fixed 30 fps output rate.
export OMNIDREAMS_TRANSITION_FRAMES="${OMNIDREAMS_TRANSITION_FRAMES:-0}"

# Rollover-frame sharpening percentage. Keep this at 0: sharpening amplified
# recursive texture and chroma artifacts in long-stream A/B tests.
export OMNIDREAMS_ROLLOVER_SHARPEN_PERCENT="${OMNIDREAMS_ROLLOVER_SHARPEN_PERCENT:-0}"

# latest reuses the last generated appearance frame. transfer enables the
# slower periodic Transfer2.5 appearance-anchor path.
export OMNIDREAMS_ROLLOVER_MODE="${OMNIDREAMS_ROLLOVER_MODE:-latest}"

# Keep the browser preview lightweight. The final MP4 remains at the model's
# fixed 30 fps; this only limits MJPEG files and delivery rate.
export OMNIDREAMS_LIVE_PREVIEW_FPS="${OMNIDREAMS_LIVE_PREVIEW_FPS:-15}"
export OMNIDREAMS_PREVIEW_BUFFER_SECONDS="${OMNIDREAMS_PREVIEW_BUFFER_SECONDS:-2.0}"

# The first CUDA shape compilation can temporarily block CityNDE for more than
# 90 seconds. Keep the process alive through that one-time compilation pause.
export TRAFFIC_CAPTURE_STALL_SECONDS="${TRAFFIC_CAPTURE_STALL_SECONDS:-300}"

# Adaptive stationary anchor. After the ego remains below the enter threshold,
# retain a clean reference and refresh it every reset interval. The reference
# is reused only while selected actor IDs and poses remain stable; actor motion
# or membership changes update it from the exact latest generated frame.
export OMNIDREAMS_STATIONARY_REFERENCE="${OMNIDREAMS_STATIONARY_REFERENCE:-0}"
export OMNIDREAMS_STATIONARY_ENTER_SECONDS="${OMNIDREAMS_STATIONARY_ENTER_SECONDS:-1.0}"
export OMNIDREAMS_STATIONARY_RESET_SECONDS="${OMNIDREAMS_STATIONARY_RESET_SECONDS:-6.0}"
export OMNIDREAMS_STATIONARY_SPEED_THRESHOLD_MPS="${OMNIDREAMS_STATIONARY_SPEED_THRESHOLD_MPS:-0.10}"
export OMNIDREAMS_STATIONARY_EXIT_SPEED_MPS="${OMNIDREAMS_STATIONARY_EXIT_SPEED_MPS:-0.8}"

# Optional resource overrides. The measured fast path uses GPUs 0-3, which are
# NUMA-local to the manager process on the validated host. Re-enabling Transfer
# moves this profile to the disjoint 4-7 partition by default.
if [[ -z "${OMNIDREAMS_GPUS:-}" ]]; then
  case "$OMNIDREAMS_PROFILE" in
    quality)
      export OMNIDREAMS_GPUS="7"
      ;;
    realtime_fast)
      case "$COSMOS_TRANSFER_ENABLED" in
        0|false|FALSE|no|NO) export OMNIDREAMS_GPUS="0,1,2,3" ;;
        *) export OMNIDREAMS_GPUS="4,5,6,7" ;;
      esac
      ;;
    *)
      export OMNIDREAMS_GPUS="4,5,6,7"
      ;;
  esac
fi
# export OMNIDREAMS_PIPELINE_CONFIG="omnidreams-sv-2steps-chunk2-loc6-vae-vae"
export OMNIDREAMS_PIPELINE_CONFIG="${OMNIDREAMS_PIPELINE_CONFIG:-omnidreams-sv-2steps-chunk2-loc6-lightvae-lighttae-perf}"
